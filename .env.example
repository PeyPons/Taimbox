# Copia a .env para desarrollo local (no commitear .env).
# Producción: mismos VITE_* en el build; STRIPE_* en supabase-pi/docker/.env y compose.

VITE_SUPABASE_URL=https://api.taimbox.com
VITE_SUPABASE_ANON_KEY=

# Stripe Checkout (Dashboard → Products → Price ID)
# Live USD/mes: Team 99 → price_1UdVFGKEVG6SFdOY6vUSLwwS · Agency 249 → price_1UdVFGKEVG6SFdOYV2XhK1DF
# Legacy early access USD (49 / 149): price_1TbpcpKEVG6SFdOYbJx5SSvO · price_1TbpcqKEVG6SFdOYPXFn8sZi
VITE_STRIPE_PRICE_ID_PRO=price_1UdVFGKEVG6SFdOY6vUSLwwS
VITE_STRIPE_PRICE_ID_BUSINESS=price_1UdVFGKEVG6SFdOYV2XhK1DF
# Opcional: precio por persona adicional (Stripe Price metered/per-seat)
# VITE_STRIPE_PRICE_ID_PRO_SEAT=price_1TeKyHKEVG6SFdOY6Ls3S2zF
# VITE_STRIPE_PRICE_ID_BUSINESS_SEAT=price_1TeKyHKEVG6SFdOY7TjtEFOG
# VITE_STRIPE_PRICE_ID_SCALE=price_1TeKyIKEVG6SFdOYV5I8IcMt
